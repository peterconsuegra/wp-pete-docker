# Per-site Apache logs: every vhost (pete.conf and the sites Pete creates) writes its
# CustomLog / ErrorLog to /var/www/html/wwwlog/<site>/. Only Apache writes these files,
# so a graceful reload is enough to reopen them after the rename. start.sh's logrotate
# loop reads this from /etc/logrotate.d.
/var/www/html/wwwlog/*/access.log /var/www/html/wwwlog/*/error.log {
    daily
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    dateext
    dateformat -%Y%m%d
    create 0644 www-data www-data
    sharedscripts
    postrotate
        /usr/sbin/apachectl -k graceful >/dev/null 2>&1 || true
    endscript
}

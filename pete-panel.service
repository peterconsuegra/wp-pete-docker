[Unit]
Description=Pete Panel - Docker Compose stack
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/pete-panel

# The stack file is /opt/pete-panel/docker-compose.yml, written by the
# installer from the profile matching this server's RAM/CPU. See
# /opt/pete-panel/.compose_profile for which one it came from.

# 1) Always pull latest images for this stack
ExecStart=/usr/bin/docker compose pull

# 2) Rebuild images (in case Dockerfiles changed)
ExecStart=/usr/bin/docker compose build

# 3) Bring the stack up in detached mode
ExecStart=/usr/bin/docker compose up -d

# 4) Properly tear the stack down when stopping the service
ExecStop=/usr/bin/docker compose down

RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
